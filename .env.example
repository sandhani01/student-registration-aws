# ==============================================================================
# Student Registration System on AWS - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' (do NOT commit .env to version control).
# 2. Replace '<MY_UNIVERSITY_ROLL_NUMBER>' with your actual university roll number.
# 3. Replace '<AWS_ACCOUNT_ID>' with your AWS Academy Learner Lab 12-digit account ID.
# ==============================================================================

# Student Identification
ROLL_NO=<MY_UNIVERSITY_ROLL_NUMBER>

# AWS Infrastructure Configuration
AWS_REGION=us-east-1
DYNAMODB_TABLE=Students-<MY_UNIVERSITY_ROLL_NUMBER>
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:<AWS_ACCOUNT_ID>:StudentRegistration-<MY_UNIVERSITY_ROLL_NUMBER>

# Flask Application Settings
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars-long
PORT=5000
HOST=0.0.0.0
